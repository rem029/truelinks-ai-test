{
  "name": "truelinks-lease-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @truelinks/api\" \"npm run dev -w @truelinks/web\"",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "samples:leases": "node scripts/generate-sample-leases.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
