{
  "name": "truelinks-lease-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @truelinks/api\" \"npm run dev -w @truelinks/web\"",
    "test": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "samples:leases": "node scripts/generate-sample-leases.mjs",
    "db:seed": "tsx apps/api/src/db/seedCli.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "docx": "^9.8.1",
    "geist": "^1.7.2",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
