# SQLite file by default; a postgres:// URL selects the Postgres dialect
DATABASE_URL=file:./var/app.db

# Where uploaded lease files are kept (original file, opened by the UI)
UPLOAD_DIR=./var/uploads

# Leave empty to run with the stub model provider
OPENROUTER_API_KEY=

# Must support text + image input, tool calling and JSON output. Cheaper alternative: z-ai/glm-5.3-flash
OPENROUTER_MODEL=xiaomi/mimo-v2.6-pro
# Fast model for simple jobs: extraction, headings, transcription
OPENROUTER_FAST_MODEL=google/gemini-3.5-flash-lite

# API port (web proxies /api to it)
API_PORT=8083
# Web (Vite) port
WEB_PORT=3000
# Extra hostnames Vite's dev server accepts, comma-separated (e.g. your code-server domain). Empty = localhost only
WEB_ALLOWED_HOSTS=
